# Base de datos
DATABASE_URL="postgresql://otp_user:otp_password@localhost:5432/otp_portal?schema=public"
POSTGRES_DB="otp_portal"
POSTGRES_USER="otp_user"
POSTGRES_PASSWORD="replace-with-a-strong-database-password"

# Backend
NODE_ENV="development"
PORT=4000
FRONTEND_URL="http://localhost:5173"
JWT_SECRET="replace-with-at-least-32-random-characters"
JWT_EXPIRES_IN="8h"
COOKIE_SECURE=false
TRUST_PROXY=false
CODE_RETENTION_DAYS=30

# Integración oficial de buzones (opcional; sin credenciales se conserva el flujo manual)
# Google callback local: http://localhost:4000/api/admin/mail/oauth/google/callback
# Microsoft callback local: http://localhost:4000/api/admin/mail/oauth/microsoft/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
# Clave AES-256 en base64; debe contener exactamente 32 bytes antes de codificar
# PowerShell: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
MAIL_TOKEN_KEY_B64=""
EMAIL_CODE_TTL_MINUTES=10

# Puerto publicado por Docker Compose
APP_PORT=8080

# Administrador inicial (usado únicamente por el seed)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-development-password"
