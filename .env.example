# Base de datos
DATABASE_URL="postgresql://otp_user:otp_password@localhost:5432/otp_portal?schema=public"
POSTGRES_DB="otp_portal"
POSTGRES_USER="otp_user"
POSTGRES_PASSWORD="replace-with-a-strong-database-password"

# Backend
NODE_ENV="development"
PORT=4000
FRONTEND_URL="http://localhost:5173"
JWT_SECRET="replace-with-at-least-32-random-characters"
JWT_EXPIRES_IN="8h"
COOKIE_SECURE=false
TRUST_PROXY=false
CODE_RETENTION_DAYS=30

# Puerto publicado por Docker Compose
APP_PORT=8080

# Administrador inicial (usado únicamente por el seed)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-development-password"
